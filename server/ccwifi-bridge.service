[Unit]
Description=CC WiFi Smart Radio Bridge & Stream Gateway
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ccwifi-bridge
ExecStart=/usr/bin/python3 /opt/ccwifi-bridge/app.py
Restart=always
RestartSec=5
Environment=PORT=5000
Environment=RADIO_IP=192.168.1.141

[Install]
WantedBy=multi-user.target
